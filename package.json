{
  "name": "@datalayer/agent-shield",
  "version": "0.2.6",
  "description": "Agent Shield: the policy document's types and the decisions' sentences, for the web and the phone.",
  "type": "module",
  "license": "BSD-3-Clause",
  "homepage": "https://github.com/datalayer/agent-shield",
  "repository": {
    "type": "git",
    "url": "https://github.com/datalayer/agent-shield.git"
  },
  "bugs": {
    "url": "https://github.com/datalayer/agent-shield/issues"
  },
  "keywords": [
    "agent",
    "shield",
    "firewall",
    "policy",
    "acp",
    "datalayer"
  ],
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./schema/policy.schema.json": "./schema/policy.schema.json"
  },
  "files": [
    "lib",
    "schema"
  ],
  "sideEffects": false,
  "scripts": {
    "clean:lib": "rimraf lib tsconfig.tsbuildinfo",
    "build": "npm run clean && tsc -b",
    "build:lib": "npm run clean:lib && tsc -b",
    "clean": "rimraf lib tsconfig.tsbuildinfo",
    "test": "node --test \"lib/__tests__/**/*.test.js\"",
    "pretest": "npm run build",
    "generate": "node scripts/generate.mjs"
  },
  "devDependencies": {
    "@types/node": "^22",
    "json-schema-to-typescript": "^16.0.0",
    "rimraf": "^5.0.0",
    "typescript": "^5.8.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
