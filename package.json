{
  "name": "@datalayer/agent-shield",
  "version": "1.1.3",
  "description": "The Datalayer orchestration A2A extension — standalone, built on no framework, consumed by any A2A client or worker.",
  "type": "module",
  "license": "BSD-3-Clause",
  "homepage": "https://github.com/datalayer/agent-shield",
  "repository": {
    "type": "git",
    "url": "https://github.com/datalayer/agent-shield.git"
  },
  "bugs": {
    "url": "https://github.com/datalayer/agent-shield/issues"
  },
  "keywords": ["A2A", "agent", "orchestration", "extension", "datalayer"],
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "files": ["lib"],
  "sideEffects": false,
  "scripts": {
    "clean:lib": "rimraf lib tsconfig.tsbuildinfo",
    "build": "npm run clean && tsc -b",
    "build:lib": "npm run clean:lib && tsc -b",
    "clean": "rimraf lib tsconfig.tsbuildinfo",
    "watch": "tsc -b -w",
    "test": "node --test lib/__tests__/**/*.test.js",
    "pretest": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22",
    "rimraf": "^5.0.0",
    "typescript": "^5.8.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
